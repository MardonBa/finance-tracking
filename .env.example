# Root .env (gitignored). Copy to .env and fill in. Never commit real values.
# `npm run sync:dev-vars` turns this into apps/api/.dev.vars for local dev.

# ---- Plaid (dev uses Sandbox only; the production secret is set with
# `wrangler secret put PLAID_SECRET --env production` and never stored here)
PLAID_CLIENT_ID=
PLAID_SANDBOX_SECRET=

# ---- Google sign-in (OAuth client for the desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only this Google account may sign in. Prefer the stable subject id ("sub");
# the email is a fallback if the sub isn't known yet.
ALLOWED_GOOGLE_SUB=
ALLOWED_GOOGLE_EMAIL=

# ---- Claude API (AI assistant, on demand only). Key from the Claude Console (platform.claude.com → API keys)
ANTHROPIC_API_KEY=

# ---- Generated by `npm run gen:secrets` (leave empty; never rotate
# TOKEN_ENC_KEY casually: stored Plaid tokens would become unreadable)
TOKEN_ENC_KEY=
BACKUP_ENC_KEY=
APP_TOKEN_PEPPER=
# Local-dev-only bearer token; `npm run reset:dev` registers it in local D1.
DEV_APP_TOKEN=
