{
  "name": "finance-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "PATH=\"$HOME/.cargo/bin:$PATH\" concurrently --kill-others --names api,app --prefix-colors blue,magenta \"npm:dev:api\" \"npm:dev:app\"",
    "dev:api": "node scripts/sync-dev-vars.mjs && npm run dev -w @ft/api",
    "dev:app": "npm run tauri -w @ft/desktop -- dev",
    "test": "npm run test:ts && npm run test:rust",
    "test:ts": "npm run test --workspaces --if-present",
    "test:rust": "cd apps/desktop/src-tauri && PATH=\"$HOME/.cargo/bin:$PATH\" cargo test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "gen:secrets": "node scripts/gen-secrets.mjs",
    "sync:dev-vars": "node scripts/sync-dev-vars.mjs",
    "reset:dev": "node scripts/reset-dev.mjs",
    "restore": "node --experimental-strip-types --no-warnings apps/api/scripts/restore.ts"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
